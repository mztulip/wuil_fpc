#!/bin/bash
# bindres - dolacza zasoby (.RES i .DFM w formacie RES16) do CALMIRA.exe przez Open Watcom wrc.
# Uzycie: wuil/bindres [exe]   (domyslnie SRC/CALMIRA.exe)
set -e
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
EXE="${1:-$ROOT_DIR/SRC/CALMIRA.exe}"
WATCOM="${WATCOM:-/tmp/watcom}"
export WATCOM
ALL=/tmp/calmira_all.res

# Scal wszystkie .RES/.DFM z renumeracja kolizyjnych ID RT_ICON (3) / RT_CURSOR (1)
# oraz pomijajac .RES nalezace do osobnych narzedzi (CTASKMAN, EXPLORER, SCRNSAVE, SHOWDESK, WNDHOOKS).
python3 - "$ROOT_DIR" "$ALL" <<'PYEOF'
import glob, os, struct, sys

root_dir, out_path = sys.argv[1], sys.argv[2]
skip_res = {'CTASKMAN.RES', 'EXPLORER.RES', 'SCRNSAVE.RES', 'SHOWDESK.RES', 'WNDHOOKS.RES'}

def parse_res16(data):
    p = 0
    recs = []
    while p < len(data):
        if data[p] == 0xff:
            rtype = struct.unpack_from('<H', data, p + 1)[0]
            p += 3
        else:
            e = data.index(0, p)
            rtype = data[p:e]
            p = e + 1
        if data[p] == 0xff:
            rname = struct.unpack_from('<H', data, p + 1)[0]
            p += 3
        else:
            e = data.index(0, p)
            rname = data[p:e]
            p = e + 1
        flags, size = struct.unpack_from('<HI', data, p)
        p += 6
        body = data[p:p + size]
        p += size
        recs.append([rtype, rname, flags, body])
    return recs

def encode_id(val):
    if isinstance(val, int):
        return struct.pack('<BH', 0xff, val)
    return val + b'\x00'

def write_res16(recs):
    out = bytearray()
    for rtype, rname, flags, body in recs:
        out += encode_id(rtype)
        out += encode_id(rname)
        out += struct.pack('<HI', flags, len(body))
        out += body
    return bytes(out)

files = (
    sorted(glob.glob(os.path.join(root_dir, 'SRC', '*.RES'))) +
    sorted(glob.glob(os.path.join(root_dir, 'SRC', '*.DFM'))) +
    sorted(glob.glob(os.path.join(root_dir, 'VCL', '*.RES'))) +
    sorted(glob.glob(os.path.join(root_dir, 'VCL', '*.DFM')))
)

next_icon_id = 1
next_cursor_id = 1
merged = []

for path in files:
    base = os.path.basename(path).upper()
    if base in skip_res:
        continue
    data = open(path, 'rb').read()
    if not data:
        continue
    recs = parse_res16(data)

    icon_map = {}
    cursor_map = {}
    for r in recs:
        if r[0] == 3 and isinstance(r[1], int):
            icon_map[r[1]] = next_icon_id
            r[1] = next_icon_id
            next_icon_id += 1
        elif r[0] == 1 and isinstance(r[1], int):
            cursor_map[r[1]] = next_cursor_id
            r[1] = next_cursor_id
            next_cursor_id += 1

    for r in recs:
        if r[0] == 14 and len(r[3]) >= 6 and icon_map:
            body = bytearray(r[3])
            cnt = struct.unpack_from('<H', body, 4)[0]
            for i in range(cnt):
                off = 6 + i * 14 + 12
                if off + 2 <= len(body):
                    old_id = struct.unpack_from('<H', body, off)[0]
                    if old_id in icon_map:
                        struct.pack_into('<H', body, off, icon_map[old_id])
            r[3] = bytes(body)
        elif r[0] == 12 and len(r[3]) >= 6 and cursor_map:
            body = bytearray(r[3])
            cnt = struct.unpack_from('<H', body, 4)[0]
            for i in range(cnt):
                off = 6 + i * 14 + 12
                if off + 2 <= len(body):
                    old_id = struct.unpack_from('<H', body, off)[0]
                    if old_id in cursor_map:
                        struct.pack_into('<H', body, off, cursor_map[old_id])
            r[3] = bytes(body)

    merged.extend(recs)

with open(out_path, 'wb') as f:
    f.write(write_res16(merged))
PYEOF

"$WATCOM/binl64/wrc" -q -bt=windows -ad "$ALL" "$EXE"
